{
  "manifest_version": 3,
  "name": "Job desk apply helper",
  "version": "1.0",
  "description": "Fills application forms from your local job desk. Never clicks Submit.",
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
