# Copy to .env in this directory (gitignored). Docker Compose reads GEMINI_API_KEY from the
# environment; `set -a; source .env; set +a` before `docker compose up`, or export the var.
#
# Alternative: run `agy auth login` on the host and mount ~/.gemini (already in docker-compose.yml).
# You only need one of: GEMINI_API_KEY or a logged-in agy session.

GEMINI_API_KEY=
