# Copy to .env in this directory (gitignored). Docker Compose reads these for
# ${VAR} substitution into the container.
#
# NVIDIA_API_KEY — Nemotron then gpt-oss-120b (https://integrate.api.nvidia.com/v1)
# OPENCODE_API_KEY — OpenCode Go subscription key (https://opencode.ai/zen/go/v1).
# Bills your Go plan; the pipeline sends x-opencode-session automatically.
# You can override the session with OPENCODE_SESSION_ID.
# GEMINI_API_KEY or `agy auth login` — last backup if both NVIDIA models fail

GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=
